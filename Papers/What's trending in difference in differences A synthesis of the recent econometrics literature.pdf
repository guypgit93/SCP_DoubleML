     <rdf:li>Causal Inference</rdf:li>
     <rdf:li>Staggered Treatment timing</rdf:li>
     <rdf:li>Sensitivity Analysis</rdf:li>
     <rdf:li>Clustering</rdf:li>
     <rdf:li>Parallel trends</rdf:li>
     <rdf:li>Treatment Effect Heterogeneity</rdf:li>
   </rdf:Bag>
</dc:subject>
