<dc:title>What's trending in difference-in-differences? A synthesis of the recent econometrics literature</dc:title>
<dc:creator>
   <rdf:Seq>
     <rdf:li>Jonathan Roth</rdf:li>
     <rdf:li>Pedro H.C. Sant'Anna</rdf:li>
